# ─────────────────────────────────────────────────────────────
# Y CONNECTOR — environment variables
# Copy to .env.local for local development. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and are
# never sent to the browser.
# ─────────────────────────────────────────────────────────────

# Public site URL (used in emails, Stripe redirects, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: path to the official logo once added to /public/brand
# NEXT_PUBLIC_LOGO_SRC=/brand/y-connector-logo.png

# ── Supabase (leave blank to run in PREVIEW/DEMO mode) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — webhooks, retention job, signup bootstrap.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (annual memberships) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring yearly Price IDs (create in Stripe → Products)
STRIPE_PRICE_ESSEX_ALUMNI=   # £30 / year
STRIPE_PRICE_STANDARD=       # £50 / year

# ── Email (optional; without these, emails are logged to the server console) ──
RESEND_API_KEY=
EMAIL_FROM="Y Connector <hello@yourdomain.com>"

# ── Security ──
# Random 32+ byte secret for signed links (university email verification). REQUIRED in production.
#   openssl rand -base64 32
APP_SIGNING_SECRET=
# Protects /api/cron/retention (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
